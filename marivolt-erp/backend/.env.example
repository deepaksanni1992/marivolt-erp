MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-strong-secret
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Searchable report PDFs (puppeteer-core + @sparticuz/chromium — no Chrome download at npm install).
# On Render, set CLIENT_URL to your Vercel app URL (e.g. https://your-app.vercel.app).
# PDF_USE_SPARTICUZ=true — use bundled Chromium on Render (also auto when RENDER is set).
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome — optional local Chrome/Chromium path.

# AWS S3 — Document Management (set on Render; never expose to frontend)
# You can use AWS_REGION or AWS_DEFAULT_REGION.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=marivolt-erp-documents

# Optional: extra prefix on every object key (e.g. prod / staging) before tenant layout.
# AWS_S3_KEY_PREFIX=prod

# Optional: separate buckets per company code (Company.code), e.g. Marivolt MAR vs Okeanos OKE — JSON map:
# AWS_S3_BUCKET_BY_COMPANY={"MAR":"marivolt-erp-documents","OKE":"okeanos-erp-documents"}
# If unset, all tenants use AWS_S3_BUCKET; uploads are still isolated by S3 path:
#   [AWS_S3_KEY_PREFIX/]tenants/{CODE}/{companyId}/...

# Per-user TOTP encryption key (32+ chars recommended). Falls back to JWT_SECRET in dev only.
TOTP_ENCRYPTION_KEY=replace-with-strong-totp-encryption-key

# Packing-label HMAC wrapping key. Required to encrypt/decrypt PackingLabelSigningKey.encryptedSecret.
# Must represent exactly 32 random bytes. Do not reuse JWT_SECRET or TOTP_ENCRYPTION_KEY.
# Accepted: exactly 64 hexadecimal characters, or canonical Base64URL without padding (32 bytes).
# Do not use raw UTF-8 strings, padded Base64, or other encodings. Do not set a placeholder value.
# PACKING_LABEL_SIGNING_ENCRYPTION_KEY=

# CUSTOMS_ENABLED=true
