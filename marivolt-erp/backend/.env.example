MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-strong-secret
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Searchable report PDFs (Puppeteer): frontend origin for /brand/* logos in generated PDFs.
# On Render, set CLIENT_URL to your Vercel app URL (e.g. https://your-app.vercel.app).
# PDF_USE_SPARTICUZ=true forces @sparticuz/chromium (auto-enabled when RENDER is set).
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome — optional local override.

# AWS S3 — Document Management (set on Render; never expose to frontend)
# You can use AWS_REGION or AWS_DEFAULT_REGION.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=marivolt-erp-documents

# Optional: extra prefix on every object key (e.g. prod / staging) before tenant layout.
# AWS_S3_KEY_PREFIX=prod

# Optional: separate buckets per company code (Company.code), e.g. Marivolt MAR vs Okeanos OKE — JSON map:
# AWS_S3_BUCKET_BY_COMPANY={"MAR":"marivolt-erp-documents","OKE":"okeanos-erp-documents"}
# If unset, all tenants use AWS_S3_BUCKET; uploads are still isolated by S3 path:
#   [AWS_S3_KEY_PREFIX/]tenants/{CODE}/{companyId}/...
