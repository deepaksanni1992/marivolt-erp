# When the UI runs on localhost (Vite dev, vite preview, or local file), the app uses /api → proxy → port 5000
# so local backend/.env (with AWS) is used. VITE_API_BASE_URL is still required for Vercel production builds.
#
# Only if you need localhost UI to call a remote API:
# VITE_USE_REMOTE_API_WHILE_LOCAL=true
#
# Production (Vercel): set VITE_API_BASE_URL to your API (no /api suffix), e.g.:
# VITE_API_BASE_URL=https://your-api.onrender.com

# Document uploads: POST /api/documents/upload — AWS keys only in marivolt-erp/backend/.env (or Render env).
