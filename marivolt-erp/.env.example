# Dev (Vite): leave both unset to use same-origin /api → Vite proxy → http://127.0.0.1:5000 (local backend + backend/.env).
# Set only if you intentionally call a remote API from dev (e.g. https://your-api.onrender.com — no /api suffix).
# VITE_API_BASE_URL=
# VITE_API_BASE=

# Production (Vercel): set VITE_API_BASE_URL to your deployed API origin (no /api suffix).
# VITE_API_BASE_URL=https://your-api.onrender.com

# Document uploads: POST /api/documents/upload — AWS keys only in marivolt-erp/backend/.env (or Render env).
